# Required in production. Generate a random value with at least 32 characters.
NUXT_SESSION_PASSWORD=replace-with-a-long-random-secret-at-least-32-characters

# Credentials accepted by the built-in account provider.
NUXT_AUTH_EMAIL=admin@tunh.app
NUXT_AUTH_PASSWORD=replace-with-a-strong-password

# Google Gemini text-to-speech (the active generator).
# Get a key at https://aistudio.google.com/apikey — when unset, the endpoint
# falls back to a mock 440 Hz tone so local dev still works.
GEMINI_API_KEY=your_gemini_api_key_here
# Optional override; defaults to gemini-2.5-flash-preview-tts.
# GEMINI_TTS_MODEL=gemini-2.5-pro-preview-tts

# Self-hosted "local" model. Used when the UI's engine selector is set to Local.
# The server POSTs { text, character, emotion, speed } to this URL and accepts
# either raw audio bytes (audio/*) or JSON { audioUrl | audioData, duration }.
# LOCAL_TTS_URL=http://localhost:5002/api/tts
# Optional bearer token sent as `Authorization: Bearer <key>`.
# LOCAL_TTS_KEY=

# Legacy voice API configuration (unused now that Gemini TTS is wired in).
# Example for ElevenLabs
VOICE_API_KEY=your_api_key_here
VOICE_API_URL=https://api.elevenlabs.io/v1

# Example for OpenAI
# VOICE_API_KEY=your_openai_key_here
# VOICE_API_URL=https://api.openai.com/v1/audio/speech

# Example for Azure Speech
# VOICE_API_KEY=your_azure_key_here
# VOICE_API_URL=https://your-region.tts.speech.microsoft.com/cognitiveservices/v1
